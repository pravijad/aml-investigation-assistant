# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection
DATABASE_URL="postgresql://user@localhost:5432/aml_assistant"

# Long random string for signing sessions: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. Without a key, the agent runs in fake mode.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5-5"

# Optional. Set to "fake" to force fake mode even when a key is set.
AGENT_MODE=""

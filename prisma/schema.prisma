// Prisma schema for the AML Alert Investigation Assistant.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  analyst
  supervisor
  admin
}

enum RiskRating {
  low
  medium
  high
}

enum InvestigationStatus {
  queued
  running
  succeeded
  failed
}

enum AlertStatus {
  new
  in_review
  info_requested
  escalated
  closed_false_positive
  closed_after_review
  report_advised
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(analyst)
  createdAt    DateTime   @default(now())
  alerts         Alert[]
  auditLogs      AuditLog[]
  investigations Investigation[]
  decisions      CaseDecision[]
}

model Customer {
  id                    String     @id @default(cuid())
  reference             String     @unique
  occupation            String
  riskRating            RiskRating @default(low)
  expectedMonthlyVolume Decimal    @db.Decimal(14, 2)
  onboardedAt           DateTime
  accounts              Account[]
  alerts                Alert[]
}

model Account {
  id            String        @id @default(cuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  accountNumber String        @unique
  type          String
  openedAt      DateTime
  transactions  Transaction[]
}

model Transaction {
  id                  String             @id @default(cuid())
  accountId           String
  account             Account            @relation(fields: [accountId], references: [id])
  occurredAt          DateTime
  amount              Decimal            @db.Decimal(14, 2)
  direction           String
  channel             String
  counterparty        String?
  counterpartyCountry String?
  description         String?
  alertLinks          AlertTransaction[]

  @@index([accountId, occurredAt])
}

model Rule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  enabled     Boolean  @default(true)
  params      Json
  baseScore   Int
  updatedAt   DateTime @updatedAt
  alerts      Alert[]
}

model Alert {
  id             String             @id @default(cuid())
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  ruleCode       String
  rule           Rule               @relation(fields: [ruleCode], references: [code])
  riskScore      Int
  status         AlertStatus        @default(new)
  summary        String
  amountInvolved Decimal            @db.Decimal(14, 2)
  windowStart    DateTime
  windowEnd      DateTime
  dedupeKey      String             @unique
  assignedToId   String?
  assignedTo     User?              @relation(fields: [assignedToId], references: [id])
  triggeredAt    DateTime           @default(now())
  decidedAt      DateTime?
  transactions   AlertTransaction[]
  investigations Investigation[]
  decisions      CaseDecision[]

  @@index([status, riskScore])
  @@index([customerId])
}

model AlertTransaction {
  alertId       String
  alert         Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([alertId, transactionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Investigation {
  id            String              @id @default(cuid())
  alertId       String
  alert         Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  status        InvestigationStatus @default(queued)
  mode          String // "fake" or "claude"
  model         String?
  promptVersion String
  result        Json?
  error         String?
  inputTokens   Int                 @default(0)
  outputTokens  Int                 @default(0)
  startedById   String
  startedBy     User                @relation(fields: [startedById], references: [id])
  createdAt     DateTime            @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  steps         InvestigationStep[]

  @@index([alertId, createdAt])
}

model InvestigationStep {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  stepNumber      Int
  toolName        String
  toolInput       Json
  outputSummary   String
  isError         Boolean       @default(false)
  createdAt       DateTime      @default(now())
}

model CaseDecision {
  id              String      @id @default(cuid())
  alertId         String
  alert           Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  decidedById     String
  decidedBy       User        @relation(fields: [decidedById], references: [id])
  decision        String
  reason          String
  fromStatus      AlertStatus
  toStatus        AlertStatus
  finalNotes      String?
  investigationId String?
  agentDraft      Json? // the agent's draft at the time of the decision, kept unchanged
  createdAt       DateTime    @default(now())

  @@index([alertId, createdAt])
}
